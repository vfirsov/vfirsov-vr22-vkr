# Локальный PostgreSQL (docker compose) и подключение API к нему.
# Значения только для localhost; на демо-стенде DATABASE_URL задаётся в переменных проекта Amvera.
POSTGRES_USER=vkr
POSTGRES_PASSWORD=vkr
POSTGRES_DB=vkr

# Адрес БД для manage_catalog.py и Gunicorn, запущенных на хосте.
# Контейнер API использует host vkr-postgres вместо 127.0.0.1 (см. README).
DATABASE_URL=postgresql+psycopg://vkr:vkr@127.0.0.1:5432/vkr
